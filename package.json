{
  "name": "voltrex-vault",
  "version": "1.0.0",
  "description": "Free, open-source, local-first password manager",
  "main": "dist/electron/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:vite && npm run build:electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:win": "node scripts/package.js --platform win",
    "package:linux": "node scripts/package.js --platform linux",
    "package:all": "node scripts/package.js --platform all",
    "package": "node scripts/package.js"
  },
  "keywords": [
    "password-manager",
    "electron",
    "react",
    "local-first",
    "argon2id",
    "aes-gcm",
    "security"
  ],
  "author": "Voltrex Digital | Mohomed Ziard",
  "license": "MIT",
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^6.4.5",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "@noble/hashes": "1.8.0"
  }
}
